# ==============================================================================
# MCP Hub Configuration
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ==============================================================================

# --- Domain & HTTPS (Caddy on Oracle Cloud) ---
DOMAIN=:80
HUB_PORT=8000

# --- Security Tokens (generate strong random strings) ---
# Used by AI clients (Claude, Antigravity, ChatGPT, CodeBuddy, WorkBuddy, Qwen, etc.)
HUB_TOKEN=change-me-hub-token
# Used by compute workers (Office PC i5-12th Gen + RX 6600 XT, Kaggle notebooks)
WORKER_TOKEN=change-me-worker-token

# --- PostgreSQL + pgvector (Oracle Cloud) ---
POSTGRES_DB=mcphub
POSTGRES_USER=mcphub
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql://mcphub:change-me-db-password@db:5432/mcphub
EMBEDDING_DIM=768

# --- Multi-LLM Router & Embedding APIs ---
# Set DEFAULT_PROVIDER to your primary API ('qwen', 'deepseek', 'baidu', 'weixin', 'gemini', 'openai', 'openrouter')
# Fill in as many API keys below as you want — all filled providers become usable simultaneously!
DEFAULT_PROVIDER=qwen
EMBED_PROVIDER=qwen
AI_TIMEOUT=90

QWEN_API_KEY=
DEEPSEEK_API_KEY=
BAIDU_API_KEY=
WEIXIN_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Fallback single-provider override (optional)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# --- Hybrid Document Storage (local | s3) ---
STORAGE_MODE=local
STORAGE_DIR=/data/files
S3_ENDPOINT=
S3_REGION=ap-singapore-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Office PC Worker Settings (i5 Gen 12, 16GB RAM, 512GB SSD, RX 6600 XT via Tailscale) ---
# Use Oracle Cloud's Tailscale IP (http://100.x.y.z:8000) or public HTTPS URL
HUB_URL=http://oracle-cloud:8000
NODE_NAME=pc
POLL_INTERVAL=10
JOB_TIMEOUT=3600
WORK_DIR=./runs

# --- Research APIs (Optional keys for higher rate limits) ---
SEMANTIC_SCHOLAR_KEY=
CROSSREF_EMAIL=researcher@example.com

# --- Kaggle API (Optional, for dataset discovery & kernel monitoring) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Notifications (Optional: Telegram Bot or Discord/Slack Webhook) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
WEBHOOK_URL=
