# ==============================================================================
# MCP Hub Configuration
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ==============================================================================

# --- Domain & HTTPS (Caddy on Oracle Cloud) ---
# Set to your domain (e.g. mcp.yourdomain.com or yourname.duckdns.org)
# For local testing without HTTPS, leave as :80
DOMAIN=:80
HUB_PORT=8000

# --- Security Tokens (generate strong random strings) ---
# Used by AI clients (Claude, Antigravity, ChatGPT, CodeBuddy, Qwen, etc.)
HUB_TOKEN=change-me-hub-token
# Used by compute workers (Office PC, Kaggle notebooks)
WORKER_TOKEN=change-me-worker-token

# --- PostgreSQL + pgvector (Oracle Cloud) ---
POSTGRES_DB=mcphub
POSTGRES_USER=mcphub
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql://mcphub:change-me-db-password@db:5432/mcphub
EMBEDDING_DIM=768

# --- Cloud AI & Embedding API (OpenAI-Compatible) ---
# Supports OpenAI, Google Gemini, Qwen (DashScope), DeepSeek, or OpenRouter:
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1
#               AI_MODEL=gpt-4o-mini | EMBED_MODEL=text-embedding-3-small
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               AI_MODEL=gemini-2.5-flash | EMBED_MODEL=text-embedding-004
#   Qwen API:   AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#               AI_MODEL=qwen-plus | EMBED_MODEL=text-embedding-v3
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
AI_TIMEOUT=90

# --- Hybrid Storage (local | s3) ---
# Start with "local" on day 1; switch to "s3" for Oracle Object Storage anytime
STORAGE_MODE=local
STORAGE_DIR=/data/files
S3_ENDPOINT=
S3_REGION=ap-singapore-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Office PC Worker Settings (used when running pc/ on Windows 11) ---
HUB_URL=http://oracle-cloud:8000
NODE_NAME=pc
POLL_INTERVAL=10
JOB_TIMEOUT=3600
WORK_DIR=./runs

# --- Research APIs (Optional keys for higher rate limits) ---
SEMANTIC_SCHOLAR_KEY=
CROSSREF_EMAIL=researcher@example.com

# --- Kaggle API (Optional, for dataset discovery & kernel monitoring) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Notifications (Optional: Telegram Bot or Discord/Slack Webhook) ---
# Alerts automatically fire when a PC or Kaggle GPU experiment finishes
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
WEBHOOK_URL=
